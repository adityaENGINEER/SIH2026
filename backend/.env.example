# Copy to .env for local development. Docker Compose sets these automatically.
OLLAMA_BASE_URL=http://localhost:11434
GENERAL_MODEL=qwen2.5:3b-instruct
VISION_MODEL=moondream
EMBEDDING_MODEL=nomic-embed-text
OLLAMA_MODELS_DIR=D:\SovereignAI\models

STORAGE_ROOT=D:\SovereignAI\storage
MAX_UPLOAD_SIZE_MB=50

# Comma-separated browser origins allowed by the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Docker defaults (set in docker-compose.yml, shown here for reference):
# OLLAMA_BASE_URL=http://ollama:11434
# STORAGE_ROOT=/data/storage

# Database (PostgreSQL optional persistence)
PERSISTENCE_BACKEND=json  # options: 'json' or 'postgres'
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=sovereignai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password_here
DATABASE_URL=postgresql://postgres:postgres_password_here@localhost:5432/sovereignai
